# Copy to .env (git-ignored) and fill in. Never commit real values.
POSTGRES_USER=rltrading
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
MLFLOW_PORT=5000

# Used by the Python code (rltrading.config.Settings)
RLTRADING_POSTGRES_DSN=postgresql://rltrading:change-me@127.0.0.1:5432/rltrading
RLTRADING_MLFLOW_TRACKING_URI=http://127.0.0.1:5000

